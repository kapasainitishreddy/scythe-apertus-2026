# Reference: https://github.com/HackApertus/project-template/tree/main/track_2b
# LLM_NAME should be the model ID actually exposed by YOUR Apertus server.
LLM_NAME=swiss-ai/Apertus-v1.5-8B
# For self-hosted vLLM accessible from Docker:
# LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_BASE_URL=
# If your server does not need a key, leave empty. NEVER COMMIT REAL KEYS.
LLM_API_KEY=
